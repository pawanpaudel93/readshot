# Maintainer: Pawan Paudel <pawanpaudel93@gmail.com>

pkgname=readshot
pkgver=0.8.0
pkgrel=1
pkgdesc="Cross-platform screenshot + offline OCR app, written in Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/pawanpaudel93/readshot"
license=('MIT')
depends=(
  'libxcb'
  'wayland'
  'libxkbcommon'
  'fontconfig'
  'dbus'
  'libayatana-appindicator'
  'gtk3'
)
makedepends=('cargo' 'pkg-config')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')  # replaced by the release pipeline

prepare() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked
}

build() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo build --release --frozen --bin readshot
}

check() {
  cd "${pkgname}-${pkgver}"
  cargo test --release --frozen --workspace
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 "target/release/readshot" "${pkgdir}/usr/bin/readshot"
  install -Dm644 "packaging/linux/readshot.desktop" \
    "${pkgdir}/usr/share/applications/${pkgname}.desktop"
  # Icon id must match `Icon=np.com.pawanpaudel.readshot` in the .desktop
  # file (512×512 PNG, mirrored from the Flatpak manifest).
  install -Dm644 "packaging/linux/readshot.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/np.com.pawanpaudel.readshot.png"
  install -Dm644 "LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
