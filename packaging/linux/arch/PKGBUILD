# Maintainer: Pawan Paudel <pawanpaudel93@gmail.com>

pkgname=readshot
pkgver=0.8.1
pkgrel=1
pkgdesc="Cross-platform screenshot + offline OCR app, written in Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/pawanpaudel93/readshot"
license=('MIT')
depends=(
  'libxcb'
  'wayland'
  'libxkbcommon'
  'fontconfig'
  'dbus'
  'libayatana-appindicator'
  'gtk3'
  # Linked at build and run time, matching CI (.github/workflows/test.yml):
  # libpipewire for xcap's Wayland capture (libspa-sys), libxdo (from
  # xdotool) for the tray menu, libgbm (from mesa) for xcap's libwayshot.
  'libpipewire'
  'xdotool'
  'mesa'
)
# clang: bindgen generates libspa-sys's bindings at build time.
makedepends=('cargo' 'pkg-config' 'clang')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')  # replaced by the release pipeline

prepare() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked
}

build() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo build --release --frozen --bin readshot
}

check() {
  cd "${pkgname}-${pkgver}"
  cargo test --release --frozen --workspace
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 "target/release/readshot" "${pkgdir}/usr/bin/readshot"
  # Named after the app id (the Wayland app_id / X11 WM_CLASS the windows
  # carry) so the desktop maps windows to this entry and its icon.
  install -Dm644 "packaging/linux/readshot.desktop" \
    "${pkgdir}/usr/share/applications/np.com.pawanpaudel.readshot.desktop"
  # Every hicolor size plus the scalable SVG (rendered by
  # packaging/render-icons.sh). The icon id matches
  # `Icon=np.com.pawanpaudel.readshot` in the .desktop file.
  local icon
  while IFS= read -r icon; do
    install -Dm644 "packaging/linux/icons/hicolor/${icon}" \
      "${pkgdir}/usr/share/icons/hicolor/${icon}"
  done < <(cd packaging/linux/icons/hicolor && find . -type f -name 'np.com.pawanpaudel.readshot.*' | sed 's|^\./||')
  install -Dm644 "LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
